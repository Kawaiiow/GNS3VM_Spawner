admin_cidr  = "x.x.x.x/32" #ไม่ค่อยจำเป็น Connect เข้าไปดูในเว็บได้ <optional>
repo_url    = "https://github.com/<owner>/GNS3VM_Spawner.git"   # ห้ามใส่ token ในบรรทัดนี้ <require>
repo_branch = "your branch" <require>
# expose_backend_port = true   # เปิด 8000 ถ้า JS ในหน้าเว็บเรียก backend ตรงๆ จากเบราว์เซอร์ <optional>
admin_password = "....." # ใช้สร้าง admin คนแรก <require>

# base_ami_id = "ami-xxxxxxxxxxxxxxxxx"   # ว่างไว้ = ใช้ netlab-gns3-base* ล่าสุดในบัญชี
# key_name    = "vockey"
# lab_instance_type = "t3.medium"

# github_token: repo private ให้ตั้งผ่าน environment แทนการเขียนลงไฟล์นี้ (ดู README หัวข้อ Repo แบบ private) ไม่ทำแตกนะเช็คได้ผ่าน Readme ข้อ 5
#   PowerShell: $env:TF_VAR_github_token="XXXXXX"   |   bash: export TF_VAR_github_token=...
