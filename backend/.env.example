# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit .env ขึ้น git)
#
# ===== AWS Academy Learner Lab =====
# ก็อป AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN จากปุ่ม
# "AWS Details" ในหน้า Lab (ต้อง Start Lab ให้ไฟเขียวก่อน) ค่าพวกนี้หมดอายุ
# ทุก ~3-4 ชม. ต้องมาก็อปใส่ใหม่ทุกครั้งที่เปิด lab session ใหม่
#
# ===== AWS account จริง =====
# ถ้าใช้ IAM user ปกติ ให้ "ลบบรรทัด AWS_SESSION_TOKEN ทิ้ง" (หรือปล่อยว่าง)
# และเปลี่ยน AWS_REGION / DEFAULT_INSTANCE_TYPE / INSTANCE_PROFILE_NAME ตาม
# ที่ระบุไว้ในคอมเมนต์แต่ละบรรทัดด้านล่าง

AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LEARNER LAB: ต้องใส่ (ก็อปจาก AWS Details)
# ACCOUNT จริง: ลบบรรทัดนี้ทิ้ง หรือปล่อยว่างไว้
AWS_SESSION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LEARNER LAB: ล็อกเป็น us-east-1 เท่านั้น
# ACCOUNT จริง: เปลี่ยนเป็น region ที่ต้องการได้ เช่น ap-southeast-1
AWS_REGION=us-east-1

# AMI ที่ทำจาก GNS3 VM appliance (ดูวิธีทำใน README ข้อ 5)
DEFAULT_AMI_ID=ami-xxxxxxxxxxxxxxxxx

# LEARNER LAB: แนะนำ t2.micro/t3.micro กัน budget lab หมดเร็ว
# ACCOUNT จริง: ปรับขึ้นได้ตามต้องการ เช่น t2.medium
DEFAULT_INSTANCE_TYPE=t2.micro

# ชื่อ EC2 Key Pair ที่สร้างไว้ใน AWS Console (EC2 > Key Pairs)
DEFAULT_KEY_NAME=gns3-cloud-keypair

# Security Group ID ที่เปิด port ให้ GNS3 (เช่น sg-0123456789abcdef0)
DEFAULT_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# LEARNER LAB: ต้องใช้ชื่อ "LabRole" เท่านั้น (Lab เตรียม role นี้ไว้ให้แล้ว)
# ACCOUNT จริง: เปลี่ยนเป็นชื่อ IAM Role ที่สร้างเอง หรือลบบรรทัดนี้ทิ้งถ้า
# instance ไม่ต้องเรียก AWS service อื่นเลย
INSTANCE_PROFILE_NAME=LabRole

MAX_CONCURRENT_INSTANCES=3

# DynamoDB Configuration
USERS_TABLE_NAME=netlab_users
INSTANCES_TABLE_NAME=netlab_instances
EXERCISES_TABLE_NAME=netlab_exercises
# DYNAMODB_ENDPOINT_URL=http://localhost:8000 # ถ้าใช้ local DynamoDB

# JWT Authentication
JWT_SECRET_KEY=netlab-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
